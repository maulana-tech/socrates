# Frontend environment variables.
# Copy to .env.local:
#   cp .env.example .env.local

# URL of the SIGAP agent API service:
# - Connect to shared development agent on EC2:
SIGAP_API=https://acy.lumbungstack.dev

# - Or connect to local agent (if running python api.py on localhost):
# SIGAP_API=http://127.0.0.1:8787
