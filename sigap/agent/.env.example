# Copy to .env and fill in the blanks. A trailing comment after a value is
# stripped, so the notes on the right are safe to leave in place.

SIGAP_SECRET=                # required. Generate: python3 manage.py secret
SIGAP_ENV=dev                # dev | staging | prod. prod refuses to start without both keys below
SIGAP_DB=data/sigap.db

SAP_BASE_URL=https://sandbox.api.sap.com
SAP_API_KEY=                 # free, 15 minutes, at https://api.sap.com. Empty means fixtures, labelled MODELLED
AWS_REGION=                  # a region that offers Claude on Bedrock. Empty means the agents refuse to reason

# Optional, defaults shown.
# SIGAP_MODEL=anthropic.claude-opus-5
# SIGAP_AUTONOMOUS_LIMIT_IDR=50000000
# SIGAP_COST_CAP_IDR=500000
