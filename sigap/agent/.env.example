# SIGAP Agent Service Configuration
# Copy this file to .env:
#   cp .env.example .env
#
# Trailing comments after values are stripped automatically.

# Application secret for signing session tokens (required)
# Generate with: PYTHONPATH=. python3 manage.py secret
SIGAP_SECRET=

# Environment: "dev" (uses fixtures if SAP is unset) | "prod" (requires SAP_API_KEY & AWS_REGION)
SIGAP_ENV=dev

# SQLite database file path (use absolute path on server, e.g., /var/lib/sigap/sigap.db)
SIGAP_DB=data/sigap.db

# Amazon Bedrock Region (e.g. ap-southeast-2 for Sydney, us-west-2 for Oregon)
AWS_REGION=ap-southeast-2

# Model ID on Amazon Bedrock:
# For cross-region Claude Haiku 4.5 in Sydney (recommended for dev & cost):
SIGAP_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# For Claude Opus 5:
# SIGAP_MODEL=anthropic.claude-opus-5

# SAP S/4HANA OData configuration
SAP_BASE_URL=https://sandbox.api.sap.com
SAP_API_KEY=                 # Free at https://api.sap.com. Empty means fixtures labelled MODELLED

# Optional budget & autonomy thresholds
SIGAP_AUTONOMOUS_LIMIT_IDR=50000000    # Default max value for autonomous action (Rp 50m)
SIGAP_COST_CAP_IDR=500000             # Max model token cost per event (Rp 500k)
