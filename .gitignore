# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example carries no values, and SETUP.md tells you to copy it.
!.env.example
!sigap/agent/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc
.env
sigap/agent/.env
sigap/agent/data/

# Hackathon service keys. Fetched from the keybroker, never committed.
sigap/agent/.secrets/

# Any secrets bundle, anywhere. A zip is the shape secrets travel in when
# somebody is sharing them, and the one that slips past a rule written for
# .env files. secrets.zip was sitting untracked in the root on 15 Oct 2026,
# one `git add -A` away from being published.
secrets.zip
*secrets*.zip
*.secrets.zip
secrets/

# Joule CLI debug dumps. They can carry credentials.
sigap/agent/debug-*.json

/data/
*.db
.codegraph/
